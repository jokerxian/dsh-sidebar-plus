{
  "name": "@jokerxian/dsh-sidebar-plus",
  "version": "1.0.1",
  "private": false,
  "type": "module",
  "description": "Sidebar Plus: folder browsing with add-to-conversation, and a full Git workbench, both in the right sidebar.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jokerxian/dsh-sidebar-plus.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host/*.js",
    "lib/*.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
